<Window x:Class="celloveszetWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:celloveszetWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="dg" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,0,425,0"/>
        <TextBox x:Name="nev_box" HorizontalAlignment="Left" Margin="536,34,0,0" TextWrapping="Wrap" Text="Huba" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="l1" HorizontalAlignment="Left" Margin="536,78,0,0" TextWrapping="Wrap" Text="20" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="l2" HorizontalAlignment="Left" Margin="536,122,0,0" TextWrapping="Wrap" Text="34" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="l3" HorizontalAlignment="Left" Margin="536,170,0,0" TextWrapping="Wrap" Text="87" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="l4" HorizontalAlignment="Left" Margin="536,217,0,0" TextWrapping="Wrap" Text="13" VerticalAlignment="Top" Width="120"/>
        <Label Content="Név: " HorizontalAlignment="Left" Margin="461,30,0,0" VerticalAlignment="Top"/>
        <Label Content="Lövés1: " HorizontalAlignment="Left" Margin="461,74,0,0" VerticalAlignment="Top"/>
        <Label Content="Lövés2: " HorizontalAlignment="Left" Margin="461,118,0,0" VerticalAlignment="Top"/>
        <Label Content="Lövés3: " HorizontalAlignment="Left" Margin="461,166,0,0" VerticalAlignment="Top"/>
        <Label Content="Lövés4: " HorizontalAlignment="Left" Margin="461,213,0,0" VerticalAlignment="Top"/>
        <Button x:Name="hozzaad" Content="Hozzáad" HorizontalAlignment="Left" Margin="536,260,0,0" VerticalAlignment="Top" Height="43" Width="120" Click="hozzaad_Click"/>
        <Button x:Name="mentes" Content="Mentés" HorizontalAlignment="Left" Margin="536,321,0,0" VerticalAlignment="Top" Height="43" Width="120" Click="mentes_Click"/>

    </Grid>
</Window>
